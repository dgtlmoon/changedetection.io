msgstr "Atur intent perubahan untuk semua monitor dalam tag/grup ini. Setiap monitor dapat menimpanya dengan intent sendiri."

#: changedetectionio/templates/edit/include_llm_intent.html
#, python-format
msgid "From group '%(name)s': %(value)s"
msgstr "Dari grup '%(name)s': %(value)s"

#: changedetectionio/templates/edit/include_llm_intent.html
msgid "e.g. Alert me when the price drops below $300, or a new product is launched. Ignore footer and navigation changes."
msgstr ""
"mis. Beri tahu saya saat harga turun di bawah $300, atau produk baru diluncurkan. Abaikan perubahan footer dan "
"navigasi."

#: changedetectionio/templates/edit/include_llm_intent.html
